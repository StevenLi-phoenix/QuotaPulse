    "JSON Lines logs live in Files → QuotaPulse → Logs and are also pushed to your Mac (Hub & Devices → Devices). Crash and hang reports from MetricKit are kept under Diagnostics.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "JSON Lines 日志在“文件”→ QuotaPulse → Logs，并会推送到你的 Mac（Hub 与设备 → 设备）。MetricKit 的崩溃/卡顿报告保存在 Diagnostics 下。"
          }
        }
      }
    },
    "Keep samples for": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "样本保留"
          }
        }
      }
    },
    "Last heartbeat \\(heartbeat) · \\(d.eventCount) events": {
