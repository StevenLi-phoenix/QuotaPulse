    "Log size": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日志大小"
          }
        }
      }
    },
    "Look for the small ring and percentage at the top right of your screen ↗. Click it for the quick panel; this window has history, settings and pairing. You can also show a Dock icon under General.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "看屏幕右上角那个小圆环和百分比 ↗。点它打开快捷面板；这个窗口里有历史、设置和配对。也可以在“通用”里打开 Dock 图标。"
          }
        }
      }
    },
    "Low": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "低"
          }
        }
