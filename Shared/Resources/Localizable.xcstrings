    "Ring only": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅圆环"
          }
        }
      }
    },
    "Run QuotaPulse on a Mac signed in to this iCloud account. Your numbers appear here as soon as it publishes.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在登录了同一 iCloud 账号的 Mac 上运行 QuotaPulse。它一发布，数字就会出现在这里。"
          }
        }
      }
    },
    "Save": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存"
          }
        }
      }
    },
    "Save thresholds": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存阈值"
          }
        }
      }
    },
    "Scan QR code": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描二维码"
          }
        }
      }
    },
    "Scan with the QuotaPulse iPhone app, or paste these values manually:": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用 iPhone 上的 QuotaPulse 扫码，或手动填入以下信息："
          }
        }
      }
    },
    "Send `Authorization: Bearer <token>`.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求头带 `Authorization: Bearer <token>`。"
          }
        }
      }
    },
    "Serve usage over the network": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过网络提供用量数据"
          }
        }
      }
    },
    "Settings": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置"
          }
        }
      }
    },
    "Share diagnostics zip": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分享诊断 zip"
          }
        }
      }
    },
    "Show": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示"
          }
        }
      }
    },
    "Show in Dock": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Dock 显示"
          }
        }
      }
    },
    "Sign in to iCloud": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请登录 iCloud"
          }
        }
      }
    },
    "Sign in to the same iCloud account as your Mac.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请登录与 Mac 相同的 iCloud 账号。"
          }
        }
      }
    },
    "Status": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "状态"
          }
        }
      }
    },
    "Stored samples": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已存样本"
          }
        }
      }
    },
    "Sync to iCloud": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同步到 iCloud"
          }
        }
      }
    },
    "That QR code isn't a QuotaPulse pairing code.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这不是 QuotaPulse 的配对二维码。"
          }
        }
      }
    },
    "Thresholds": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阈值"
          }
        }
      }
    },
    "Token": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Token"
          }
        }
      }
    },
    "URL": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "URL"
          }
        }
      }
    },
    "Upload logs to hub now": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即上传日志到 Hub"
          }
        }
      }
    },
    "Used": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已用"
          }
        }
      }
    },
    "Version": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "版本"
          }
        }
      }
    },
    "Waiting for first refresh…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待首次刷新…"
          }
        }
      }
    },
    "Waiting for your Mac": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在等待你的 Mac"
          }
        }
      }
    },
    "Widgets & Watch": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "小组件与手表"
          }
        }
      }
    },
    "Widgets refresh from iCloud about every 15 minutes, or sooner when your Mac publishes. The watch reads iCloud too, and this iPhone also forwards data to it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "小组件大约每 15 分钟从 iCloud 刷新一次，Mac 发布时可能更快。手表同样读取 iCloud，这台 iPhone 也会把数据转发给它。"
          }
        }
      }
    },
    "Window": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口"
          }
        }
      }
    },
    "You can still connect directly to your Mac over your network or Tailscale.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你仍可通过局域网或 Tailscale 直接连接到 Mac。"
          }
        }
      }
    },
    "Your Mac hasn't published anything recently. Check that QuotaPulse is running there and has internet access.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 Mac 最近没有发布新数据。请确认那边的 QuotaPulse 正在运行且能联网。"
          }
        }
      }
    },
    "Your Mac publishes to your private iCloud database and this device reads it from anywhere. If nothing arrives, compare the account ID with the one shown on your Mac.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 把数据发布到你私有的 iCloud 数据库，这台设备在任何地方都能读取。如果一直没有数据，请核对这里的账号标识是否与 Mac 上显示的一致。"
          }
        }
      }
    },
    "Your iPhone and Apple Watch get these numbers from anywhere once they're signed in to the same iCloud account, with nothing to pair. Only usage numbers, plan names and this Mac's name go to your private iCloud database. API keys and tokens never leave this Mac.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 和 Apple Watch 登录同一 iCloud 账号后，无需配对，在任何地方都能看到这些数字。写入你私有 iCloud 数据库的只有用量数字、套餐名称和这台 Mac 的名字，API key 和 token 绝不会离开这台 Mac。"
          }
        }
      }
    },
    "\\(QuotaFormat.wholeDays($0)) days": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(QuotaFormat.wholeDays($0)) 天"
          }
        }
      }
    },
    "\\(u.count) lines · \\(u.at.formatted(date: .omitted, time: .shortened))": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(u.count) 行 · \\(u.at.formatted(date: .omitted, time: .shortened))"
          }
        }
      }
    },
    "iCloud": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud"
          }
        }
      }
    },
    "iCloud account ID": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 账号标识"
          }
        }
      }
    },
    "macOS asks for notification permission the first time you turn this on. Each threshold fires once per window cycle.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首次开启时 macOS 会请求通知权限。每个阈值在每个窗口周期内只触发一次。"
          }
        }
      }
    },
    "n/a": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无"
          }
        }
      }
    }
  },
  "version": "1.0"
}
