    "JSON Lines logs live in Files → QuotaPulse → Logs. With a direct connection they are also pushed to your Mac (Hub & Devices → Devices). Crash and hang reports from MetricKit are kept under Diagnostics.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "JSON Lines 日志位于“文件”→ QuotaPulse → Logs。建立直接连接后还会推送到 Mac（Hub 与设备 → 设备）。MetricKit 的崩溃和卡顿报告保存在 Diagnostics 下。"
          }
        }
      }
    },
    "Keep samples for": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "样本保留"
          }
        }
      }
    },
    "Last heartbeat \\(heartbeat) · \\(d.eventCount) events": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最近心跳 \\(heartbeat) · \\(d.eventCount) 条事件"
