    "Reveal data folder": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Finder 中显示数据目录"
          }
        }
      }
    },
    "Reveal in Finder": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
