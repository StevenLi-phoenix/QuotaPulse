    "This Mac polls the providers; your other devices only read JSON from it over an authenticated local HTTP endpoint. No cloud, no Apple paid services.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由这台 Mac 轮询各供应商；其他设备只通过带鉴权的本地 HTTP 接口读取 JSON。不经云端，不依赖 Apple 付费服务。"
          }
        }
      }
    },
