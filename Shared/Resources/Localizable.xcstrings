      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上次上传"
          }
        }
      }
    },
    "Launch at login": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录时启动"
          }
        }
      }
    },
    "Lines waiting for the hub": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "待上传到 Hub 的行数"
          }
        }
      }
