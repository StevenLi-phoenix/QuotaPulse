    "Each device uploads its JSON Lines log on refresh to POST /v1/telemetry; files land under telemetry/<device>/YYYY-MM-DD.log next to the hub data.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每台设备刷新时把 JSON Lines 日志 POST 到 /v1/telemetry；文件落在 hub 数据旁的 telemetry/<设备>/YYYY-MM-DD.log。"
          }
        }
      }
    },
    "Enable a provider in Settings or wait for the first refresh.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在设置中启用一个供应商，或等待首次刷新。"
