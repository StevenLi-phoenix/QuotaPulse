    "Widgets & Watch": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "小组件与手表"
          }
        }
      }
    },
    "Widgets read the last snapshot from the shared container and refresh in the background about every 15 minutes. The watch receives data from this iPhone and can also reach the hub directly.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "小组件从共享容器读取最新快照，并大约每 15 分钟在后台刷新。手表从这台 iPhone 接收数据，也可以直接访问 Hub。"
          }
        }
      }
    },
    "Window": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口"
          }
        }
      }
    },
    "Your Mac hasn't published a snapshot yet. Make sure QuotaPulse is running there.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 Mac 还没有发布快照。请确认那边的 QuotaPulse 正在运行。"
          }
        }
      }
    },
    "\\(Int($0.rounded())) days": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(Int($0.rounded())) 天"
          }
        }
      }
    },
    "macOS asks for notification permission the first time you turn this on. Each threshold fires once per window cycle.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首次开启时 macOS 会请求通知权限。每个阈值在每个窗口周期内只触发一次。"
          }
        }
      }
    }
